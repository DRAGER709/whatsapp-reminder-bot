# Server
PORT=3000
VERIFY_TOKEN=your_webhook_verify_token
PUBLIC_URL=https://your-app-url.onrender.com  # Required for keep-alive self-ping
CRON_SECRET=your_random_secret_string         # Required: protects /api/tick — use any long random string

# WhatsApp (Meta Cloud API)
MY_PHONE_NUMBER=91xxxxxxxxxx
PHONE_NUMBER_ID=your_phone_number_id
ACCESS_TOKEN=your_permanent_access_token
WEBHOOK_APP_SECRET=your_meta_app_secret   # App Dashboard → Settings → Basic → App Secret

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Preferred for this backend: Supabase Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback only; do not use this for a browser client.
SUPABASE_KEY=your_anon_or_publishable_key

# AI — Tier 1 & 2
GEMINI_API_KEY=your_gemini_api_key

# AI — Tier 3 fallback
GROQ_API_KEY=your_groq_api_key

# AI — Tier 4 fallback
OPENROUTER_API_KEY=your_openrouter_api_key

# Web search — primary
TAVILY_API_KEY=your_tavily_api_key

# Web search — fallback
SERPER_API_KEY=your_serper_api_key
